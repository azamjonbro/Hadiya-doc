# Production env for qollanma.techinfo.uz — copy to backend/.env ON THE
# SERVER and fill in every <...> placeholder. Do NOT reuse the local dev
# secrets from backend/.env: generate fresh ones with
#   openssl rand -hex 48
#
# Filename note: this is committed as backend.env.example rather than
# .env.production.example because .gitignore excludes `.env.*`.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Mongo runs natively on this box at 127.0.0.1:27017 and requires auth.
# Port 27017 is NOT reachable from outside the box (verified: connections to
# the public IP are refused), so the host here must stay 127.0.0.1 — use an
# SSH tunnel if you need to reach it from a workstation.
# It also hosts OTHER sites' databases — keep this URI scoped to the single
# corporate-lms database and never restore with a whole-instance --drop.
# Percent-encode reserved characters in the password (& -> %26, @ -> %40).
MONGO_URI=mongodb://<db-user>:<db-password>@127.0.0.1:27017/corporate-lms?authSource=admin

# Each host serves its own SPA and proxies /api to this same backend, so
# every request is same-origin and CORS never preflights. socket.io is the
# exception that still needs the list: browsers always send Origin on a
# WebSocket handshake and realtime/socket.js checks it against these
# values, so a missing admin origin breaks chat/presence/notifications
# silently while the REST API keeps working.
ALLOWED_ORIGINS=https://qollanma.techinfo.uz,https://admin.qollanma.techinfo.uz
# An explicit Domain attribute also covers subdomains, so the admin host
# receives the refresh cookie without widening this. Do NOT widen it to
# .techinfo.uz — that hands the cookie to the six unrelated sites here.
COOKIE_DOMAIN=qollanma.techinfo.uz
COOKIE_SAMESITE=strict

JWT_ACCESS_SECRET=<openssl rand -hex 48>
JWT_REFRESH_SECRET=<openssl rand -hex 48>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CSRF_SECRET=<openssl rand -hex 48>

# Seeded on first boot only, and only if no SUPERADMIN exists yet. Since
# the local database is being restored over this one, the SuperAdmin from
# that dump is what you will actually log in as — these values then never
# take effect. Set a real password anyway.
SUPERADMIN_EMAIL=azamjonbro@gmail.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=<strong-password>

# Captcha is bypassed (with a logged warning) while this is blank. Set a
# real hCaptcha secret before the login form is publicly reachable.
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Redis is NOT installed on this box yet — install it before first boot,
# or the BullMQ queues and cache fail at startup.
REDIS_URL=redis://127.0.0.1:6379

# MinIO is NOT installed on this box yet either. Bind it to loopback only;
# nginx does not proxy it, the backend reaches it directly.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=<minio-access-key>
S3_SECRET_KEY=<minio-secret-key>
S3_BUCKET_ORIGINALS=lms-originals
S3_BUCKET_PROCESSED=lms-processed
S3_BUCKET_IMAGES=lms-images
S3_BUCKET_MATERIALS=lms-materials
S3_BUCKET_CHAT=lms-chat
S3_PUBLIC_URL=
# Host the browser must use for presigned links (material downloads, chat
# attachments). Leave empty and every signed URL points at S3_ENDPOINT —
# i.e. 127.0.0.1:9000, which the browser cannot reach, so PDFs render as
# "refused to connect" and the download button does nothing. The signature
# covers this host, so it cannot be rewritten after the fact; nginx must
# route /lms-materials/ and /lms-chat/ to MinIO without touching the path.
S3_SIGNING_ENDPOINT=https://qollanma.techinfo.uz
MATERIAL_MAX_FILE_SIZE_MB=100
MATERIAL_DOWNLOAD_URL_TTL=120

VIDEO_TOKEN_SECRET=<openssl rand -hex 48>
VIDEO_PLAYBACK_TOKEN_TTL=180

# Leave blank to keep /ai-chat responding AI_CHAT_UNAVAILABLE.
ANTHROPIC_API_KEY=
