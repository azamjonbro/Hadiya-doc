# --- Phase 1: required now ---
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/corporate-lms
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# info = business events + errors only. Set to `http` in production to also
# get the per-request access log (method/path/status/duration/ip/userId —
# spec §49); `debug` adds framework-internal noise on top of that.
LOG_LEVEL=info
# IANA zone used for "same calendar day" checks (currently: daily face
# verification). Not hardcoded so a deployment outside this timezone just
# changes this value.
APP_TIMEZONE=Asia/Tashkent

# --- Phase 2 (Auth/RBAC): required now ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CSRF_SECRET=
COOKIE_DOMAIN=localhost
# 'strict' whenever the SPAs and the API share a registrable domain
# (app.example.com + api.example.com) — leave it alone in that case.
# Set 'none' ONLY for a genuinely cross-site frontend (*.vercel.app or
# *.netlify.app calling an API on another domain): a strict/lax refresh
# cookie is never attached to POST /auth/refresh, so sessions die at the
# access token's TTL and cannot be restored. 'none' requires HTTPS and
# NODE_ENV=production, and every frontend origin must be in ALLOWED_ORIGINS.
COOKIE_SAMESITE=strict
# SuperAdmin is seeded from these on first boot only if no SUPERADMIN exists yet.
# Never use a default password in production.
SUPERADMIN_EMAIL=
# 14 digits. Only read on a fresh install, when no SUPERADMIN exists yet.
SUPERADMIN_JSHSHIR=
SUPERADMIN_PASSWORD=
CAPTCHA_PROVIDER=hcaptcha
# Leave blank in development to bypass captcha verification (a warning is logged).
CAPTCHA_SECRET=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Face verification (face check before login, video, material and test) ---
# Master kill-switch. Everything below is inert while this is false.
FACE_VERIFICATION_ENABLED=false
# Gates users SUPERADMIN has enrolled once ENABLED=true.
FACE_VERIFICATION_REQUIRED=false
# If true, users nobody has enrolled yet are blocked too. Leave false during
# rollout so unenrolled legacy employees aren't locked out on day one.
FACE_VERIFICATION_ENFORCE_UNENROLLED=false
FACE_MATCH_THRESHOLD=0.55
# How recent a check counts as, when Settings -> Face verification has
# "verify before every video, material and test" turned on. Ignored in the
# default once-a-day mode.
FACE_VERIFICATION_FRESH_SECONDS=120
FACE_VERIFICATION_MAX_ATTEMPTS=5
FACE_VERIFICATION_LOCK_MINUTES=15
FACE_CHALLENGE_TTL_SECONDS=300

# --- Phase 6+ (video processing queue, caching): required now ---
REDIS_URL=redis://localhost:6379

# --- Phase 5+ (video storage): required now ---
# Values below match the MinIO service in docker-compose.yml for local dev.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=lms_minio_admin
S3_SECRET_KEY=lms_minio_secret
S3_BUCKET_ORIGINALS=lms-originals
S3_BUCKET_PROCESSED=lms-processed
S3_BUCKET_IMAGES=lms-images
# Optional — set to a CDN/public domain in production if images shouldn't
# be served directly from S3_ENDPOINT.
S3_PUBLIC_URL=

# Host that presigned URLs are signed for — material downloads, audio
# playback and chat attachments. Empty (local dev) signs with S3_ENDPOINT.
#
# In production this MUST be the public API host that proxies the bucket
# paths to storage, because a SigV4 signature covers the host and the path:
# a link signed for the internal loopback address is unreachable from a
# browser, and re-pointing it afterwards invalidates the signature. The
# proxy must not rewrite the path either (`/lms-materials/<key>` has to
# arrive at storage unchanged) — see deploy/spring/nginx-qollanma-api.conf.
#
# It is a separate variable from S3_ENDPOINT on purpose: the server's own
# reads and writes stay on loopback instead of going out to the internet
# and back. Because nothing else in the app notices when this is stale,
# it survived a domain move once and silently broke every download for a
# week; after any change to the domain or the proxy, verify with:
#   npm --prefix backend run check:signing
S3_SIGNING_ENDPOINT=

# --- Topic content (materials: files/presentations/multimedia) ---
# Private bucket — served only via short-lived signed URLs, never public.
S3_BUCKET_MATERIALS=lms-materials
MATERIAL_MAX_FILE_SIZE_MB=100
MATERIAL_DOWNLOAD_URL_TTL=120

# --- Chat attachments (images, files, voice notes) ---
# Private bucket — served only via short-lived signed URLs, never public.
S3_BUCKET_CHAT=lms-chat
CHAT_MAX_FILE_SIZE_MB=25
CHAT_ATTACHMENT_URL_TTL=3600

# --- Face enrollment reference photos ---
# Private bucket, never public — same treatment as lms-proctor.
S3_BUCKET_FACES=lms-faces

# --- Phase 7 (secure video streaming): required now ---
VIDEO_TOKEN_SECRET=
VIDEO_PLAYBACK_TOKEN_TTL=180

# --- Phase 13 (AI chatbot): optional — without a key, POST /ai-chat/messages
# returns an AI_CHAT_UNAVAILABLE error instead of crashing the server on boot.
ANTHROPIC_API_KEY=

# --- Nightly encrypted database backup (docs/deployment.md §5) ---
# Off by default. Turning it on without a key refuses to boot, on purpose:
# a backup job with no key would only fail nightly in a log nobody reads.
BACKUP_ENABLED=false
# 32 bytes, hex. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store it in the password manager as well — an archive whose key was lost
# with the machine that made it is not a backup.
BACKUP_ENCRYPTION_KEY=
# Private bucket, like materials and chat. It holds every JSHSHIR, password
# hash and proctoring record at once — it must never be public-read.
S3_BUCKET_BACKUPS=lms-backups
BACKUP_RETENTION_DAYS=30
# Cron, in APP_TIMEZONE. The sweep always keeps the newest archive, so a
# month of failed backups cannot delete the last good one.
BACKUP_SCHEDULE_CRON=20 3 * * *
# mongodump/mongorestore ship separately from the mongo server and are often
# missing from a PM2 process's PATH. Absolute paths are fine here.
MONGODUMP_BIN=mongodump
MONGORESTORE_BIN=mongorestore

# --- Error tracking: Sentry or self-hosted GlitchTip (same ingest API) ---
# Empty = disabled, no outbound calls. Every logger.error() in the app is
# reported; entries are redacted before the tracker ever sees them.
# Shape: https://<publicKey>@<host>/<projectId> — a DSN missing its key
# fails at boot rather than reporting nothing.
SENTRY_DSN=
# Defaults to NODE_ENV. Set when staging and production share one project.
SENTRY_ENVIRONMENT=
# Commit sha of the running build, so an issue says which deploy it is from.
SENTRY_RELEASE=
