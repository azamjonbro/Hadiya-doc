# Admin app — production build config.
#
# Committed on purpose (see the .gitignore exception): VITE_* values are
# baked into the JS bundle at build time and are therefore public by
# definition. Never put a secret in this file.
#
# Points at the same API host as the employee app. Must be the ABSOLUTE
# origin, not a bare /api/v1 — src/services/socket.js derives the socket.io
# origin by stripping the /api/v1 suffix off this value.
#
# Note on cookies: the refresh cookie is SameSite=Strict, so the admin app
# must be served from somewhere same-site with this API — a subdomain such
# as admin.qollanma.techinfo.uz works (the registrable domain is
# techinfo.uz), a *.vercel.app host does NOT and would need
# COOKIE_SAMESITE=none on the backend.
#
# A shell/dashboard-provided VITE_API_BASE_URL takes precedence over this
# file, so a Vercel or Netlify env var can still override it per-site.
VITE_API_BASE_URL=https://qollanma.techinfo.uz/api/v1
