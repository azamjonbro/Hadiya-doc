# Employee app — production build config.
#
# Committed on purpose (see the .gitignore exception): VITE_* values are
# baked into the JS bundle at build time and are therefore public by
# definition. Never put a secret in this file.
#
# Must be the ABSOLUTE origin, not a bare /api/v1 — src/services/socket.js
# derives the socket.io origin by stripping the /api/v1 suffix off this
# value, and a relative path would leave it empty and break chat, presence
# and the notification badge.
#
# A shell/dashboard-provided VITE_API_BASE_URL takes precedence over this
# file, so a Vercel or Netlify env var can still override it per-site.
VITE_API_BASE_URL=https://qollanma.techinfo.uz/api/v1
