# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# env
.env
.env.*
!.env.example
# The two frontend production builds are the exception: VITE_* values are
# baked into the public JS bundle at build time, so they are not secrets,
# and committing them keeps Vercel/Netlify builds correct without any
# dashboard configuration. Scoped to these two paths on purpose — a
# backend/.env.production would hold real secrets and must stay ignored.
!front/.env.production
!admin/.env.production

# logs
logs/
*.log
npm-debug.log*

# local storage / uploads (LocalStorageProvider dev data) — anchored to the
# repo-root-level runtime data directory, NOT backend/src/services/uploads/
# (that's source code for the image-upload feature, not runtime data)
/storage/
/backend/uploads/
tmp/

# OS
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# test / coverage
coverage/

# docker
docker-compose.override.yml

# MediaPipe runtime + face model for attention monitoring (~26MB).
# Staged by: npm run assets:mediapipe --workspace front
front/public/mediapipe/

# face-api.js detection/recognition models for face verification (~12MB).
# Staged by: npm run assets:face-models --workspace backend
backend/models/face-api/
