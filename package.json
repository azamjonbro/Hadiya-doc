{
  "name": "corporate-lms",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/shared",
    "backend",
    "front"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:worker": "npm run worker --workspace backend",
    "dev:front": "npm run dev --workspace front",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "status": "node tools/status/server.js",
    "status:tests": "node tools/status/record-tests.js"
  }
}
